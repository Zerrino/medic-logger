<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/notification_marker" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="8dp" android:src="@drawable/notification_dot" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/notification_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" style="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <ImageButton android:id="@+id/notification_previous" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_chevron_left" android:scaleType="center" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" />
    <ImageButton android:id="@+id/notification_next" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_chevron_right" android:scaleType="center" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" />
    <Button android:id="@+id/notification_active" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="64dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:background="?android:attr/selectableItemBackgroundBorderless" />
    <Button android:id="@+id/notification_over" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="64dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>
