<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
    <ImageButton android:id="@+id/notification_previous" android:layout_width="56dp" android:layout_height="48dp" android:padding="2dp" android:scaleType="centerInside" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/notification_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" style="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" style="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <ImageButton android:id="@+id/notification_next" android:layout_width="56dp" android:layout_height="48dp" android:padding="2dp" android:scaleType="centerInside" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" />
    <Button android:id="@+id/notification_active" android:layout_width="64dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:padding="4dp" android:textAllCaps="false" android:textSize="12sp" android:maxLines="1" android:background="@drawable/notification_action" android:textColor="#9B2933" />
    <Button android:id="@+id/notification_over" android:layout_width="64dp" android:layout_height="48dp" android:padding="4dp" android:textAllCaps="false" android:textSize="12sp" android:maxLines="1" android:background="@drawable/notification_action" android:textColor="#9B2933" />
</LinearLayout>
