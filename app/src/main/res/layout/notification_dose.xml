<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/notification_marker" android:layout_width="6dp" android:layout_height="40dp" android:background="#B63840" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/notification_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" style="@android:style/TextAppearance.Material.Notification.Title" />
            <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:maxLines="2" style="@android:style/TextAppearance.Material.Notification" />
            <TextView android:id="@+id/notification_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:maxLines="2" style="@android:style/TextAppearance.Material.Notification.Info" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/notification_carousel" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/notification_previous" android:layout_width="56dp" android:layout_height="56dp" android:padding="2dp" android:scaleType="centerInside" android:contentDescription="@null" android:background="@android:color/transparent" />
        <TextView android:id="@+id/notification_position" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" style="@android:style/TextAppearance.Material.Notification" />
        <ImageButton android:id="@+id/notification_next" android:layout_width="56dp" android:layout_height="56dp" android:padding="2dp" android:scaleType="centerInside" android:contentDescription="@null" android:background="@android:color/transparent" />
    </LinearLayout>
</LinearLayout>
