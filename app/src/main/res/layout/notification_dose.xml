<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/notification_marker" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="8dp" android:src="@drawable/notification_dot" android:importantForAccessibility="no" />
        <TextView android:id="@+id/notification_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" style="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>
    <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:maxLines="2" style="@android:style/TextAppearance.Material.Notification" />
    <TextView android:id="@+id/notification_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:maxLines="2" style="@android:style/TextAppearance.Material.Notification" />
    <LinearLayout android:id="@+id/notification_carousel" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="2dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/notification_previous" android:layout_width="56dp" android:layout_height="44dp" android:src="@drawable/ic_chevron_left" android:scaleType="center" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/notification_position" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="12sp" style="@android:style/TextAppearance.Material.Notification" />
        <ImageButton android:id="@+id/notification_next" android:layout_width="56dp" android:layout_height="44dp" android:src="@drawable/ic_chevron_right" android:scaleType="center" android:contentDescription="@null" android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
